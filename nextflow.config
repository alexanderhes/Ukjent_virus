/*
 * EsViritu Nextflow Pipeline — main configuration
 */

// Load default parameters
includeConfig 'conf/params.config'

// Docker — always enabled (matches deployment environment)
docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

// Container per process
includeConfig 'conf/docker.config'

// Resource labels
includeConfig 'conf/base.config'

// Executor
executor {
    name      = 'local'
    queueSize = 8
}

// Capture Nextflow log files into the output directory
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

// ── Server profile ──────────────────────────────────────────────────────────
// Activate with: -profile server
// Sets static paths for the server environment so they don't need to be
// passed on the command line each time.
profiles {
    server {
        params {
            // Bowtie2 index prefix — Nextflow globs host_index*.bt2 from this path
            host_index  = '/mnt/tempdata/ukjent_virus_dbs/host_ref/host_index'
            // EsViritu database directory — passed directly to EsViritu --db
            esviritu_db = '/mnt/tempdata/ukjent_virus_dbs/db/esviritu_DB/v3.2.4'
        }
    }
}
