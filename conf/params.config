/*
 * Default pipeline parameters
 * Override on the command line:  --param value
 * or in a custom params file:    -params-file my_params.yaml
 */

params {
    // ── Required ───────────────────────────────────────────────────────────────
    samplesheet     = null          // Path to samplesheet CSV/TSV (sample;fastq_dir)
    host_index      = null          // Path to bowtie2 index prefix (without .bt2 extension)
    esviritu_db     = null          // Path to EsViritu virus database directory

    // ── Output ─────────────────────────────────────────────────────────────────
    outdir          = './results'

    // ── Samplesheet ────────────────────────────────────────────────────────────
    samplesheet_sep = ';'           // Column delimiter (';' | ',' | '\t')

    // ── Host filter ────────────────────────────────────────────────────────────
    // false (default): single paired-end bowtie2 run with --sensitive-local.
    // true: original high-sensitivity mode — unpaired --very-sensitive-local on
    //       R1 and R2 separately, then seqkit pair re-synchronisation.
    sensitive_host_filter   = false

    // ── fastp ──────────────────────────────────────────────────────────────────
    min_length              = 50
    quality_cutoff          = 20
    complexity_threshold    = 30    // Low-complexity filter threshold (0-100)

    // ── EsViritu ───────────────────────────────────────────────────────────────
    esviritu_keep   = true          // Keep temp files (needed for future downstream modules)

    // ── Validation sub-workflow ───────────────────────────────────
    validate                = false   // Enable per-species assembly + BLAST validation
    validate_min_reads      = 50      // Min reads per species to attempt SPAdes assembly
    validate_min_contig_len = 800     // Filter SPAdes contigs shorter than this (nt)
    validate_spades_max_pairs = 500000 // If >0, subsample sample-level read pairs above this cap before SPAdes
    validate_spades_sample_seed = 11   // Random seed for deterministic SPAdes input subsampling

    // ── Overview verdict thresholds ─────────────────────────────────────
    // WORK IN PROGRESS: the verdict_* values below are provisional. They were
    // set from one 3-sample test run (20260930_hanta_test), are not validated,
    // and are expected to change. While verdict_thresholds_provisional = true,
    // every run prints a warning at start and end; set it to false once the
    // thresholds have been validated.
    verdict_thresholds_provisional = true
    // Mapping evidence (EsViritu): esv_verdict = supported when both pass.
    // Failing one raises esv_flags low_reads / low_breadth.
    verdict_esv_min_reads        = 10    // Min EsViritu read count
    verdict_esv_min_breadth_pct  = 5     // Min EsViritu breadth of coverage (%)
    // De novo evidence (SPAdes + BLAST), judged on the best contig per taxon.
    // The artefact thresholds also raise blast_flags short_alignment / low_contig_cov.
    verdict_contig_min_aln_bp    = 300   // blast_verdict = confirmed: aligned bp >= this ...
    verdict_contig_min_aln_pct   = 50    // ... and % of contig aligned >= this
    verdict_artefact_max_aln_bp  = 200   // blast_verdict = artefact_suspected: aligned bp < this ...
    verdict_artefact_max_aln_pct = 20    // ... or % of contig aligned < this
    // Flags only (do not change verdicts).
    verdict_esv_divergent_identity_pct   = 90  // esv_flags divergent: EsViritu read identity (%) < this
    verdict_blast_divergent_identity_pct = 90  // blast_flags divergent: BLAST identity (%) < this
    verdict_recurrent_min_samples        = 2   // flags in_<k>/<N>_samples: taxon in >= this many samples
    // SPAdes assembly mode used during validation.
    // null = auto-detect from esviritu_db name (HEV → rnaviral, otherwise meta).
    // Override explicitly: rnaviral | meta | isolate
    spades_mode             = null
    // Taxonomic level used for grouping reads before assembly.
    // 'subspecies' (default): uses subspecies where available, falling back to species.
    //   Recommended for virus groups where one Species contains many distinct viruses
    //   (e.g. Enteroviruses, Rotaviruses).
    // 'species': always group at species level.
    assembly_taxon_level    = 'subspecies'

    // ── Misc ───────────────────────────────────────────────────────────────────
    max_cpus        = 8
    max_memory      = '128.GB'
    max_time        = '72.h'
}
