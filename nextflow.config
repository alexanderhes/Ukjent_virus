/*
 * EsViritu Nextflow Pipeline — main configuration
 */

// Load default parameters
includeConfig 'conf/params.config'

// Docker — always enabled (matches deployment environment)
docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

// Container per process
includeConfig 'conf/docker.config'

// Resource labels
includeConfig 'conf/base.config'

// Executor
executor {
    name      = 'local'
    queueSize = 8
}

// Capture Nextflow log files into the output directory
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

// ── Profiles ────────────────────────────────────────────────────────────────
// Activate with: -profile <name> or combined: -profile server,host_human,db_v3_2_4
//
//  server           — server-level infrastructure settings (reserved for future use)
//  host_<alias>     — Bowtie2 host reference selection; one profile per host species
//                     Add a new block here and register the alias in NGS_wrapper.sh
//                     (VALID_HOST_ALIASES) to make it selectable at runtime.
//  db_<alias>       — EsViritu database selection; one profile per DB version
//                     Add a new block here and register the alias in NGS_wrapper.sh
//                     (VALID_DB_ALIASES) to make it selectable at runtime.
profiles {

    // ── Host environment (reserved for future server-specific settings) ────
    server {
    }

    // ── Host reference genomes ─────────────────────────────────────────────
    // Each profile sets params.host_index to the bowtie2 index prefix for that
    // species. Nextflow globs host_index*.bt2 from that path.
    // Pass -H <alias> to NGS_wrapper.sh to select one at runtime.

    host_human {
        params {
            // Human T2T reference (GCA_009914755.4) + PhiX174
            host_index = '/mnt/tempdata/ukjent_virus_dbs/host_ref/human_t2t/host_index'
        }
    }
    host_moose {
        params {
            // Norwegian moose (Alces alces) reference — update path once index is built
            host_index = '/mnt/tempdata/ukjent_virus_dbs/host_ref/moose_ref/moose_index'
        }
    }

    // ── EsViritu database versions ─────────────────────────────────────────
    // Each profile sets params.esviritu_db to the corresponding directory.
    // Pass -d <alias> to NGS_wrapper.sh to select one at runtime.

    db_v3_2_4 {
        params {
            esviritu_db = '/mnt/tempdata/ukjent_virus_dbs/db/esviritu_DB/v3.2.4'
        }
    }
    db_HEV {
        params {
            esviritu_db = '/mnt/tempdata/ukjent_virus_dbs/db/HEV_595/'
        }
    }
}
