# Copy to tests/local/regression.env (gitignored) and fill in local paths.
# Never commit the filled-in file: the samplesheet path and its contents name samples.

# Semicolon-separated samplesheet: sample;fastq_dir (absolute paths), local data only
SAMPLESHEET=/path/to/local/samplesheet.csv

HOST_INDEX=/path/to/host_ref/host_index
HOST_BLASTDB=/path/to/host_ref/blastdb/host_ref
ESVIRITU_DB=/path/to/esviritu_DB/v3.2.4

# Resource limits for this machine, e.g.
#   params { max_cpus = 8; max_memory = '48.GB' }
#   process { withName: 'SPADES_ASSEMBLY' { memory = 40.GB } }
LOCAL_CONFIG=/path/to/tests/local/local.config

# Optional
#BASELINE=/path/to/tests/local/baseline
#REL_TOL=0.01      # relative tolerance for numeric columns
#ABS_TOL=2         # absolute tolerance for numeric columns
#EXTRA_ARGS=""     # more pipeline parameters
