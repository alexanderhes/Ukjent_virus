/*
 * Container configuration
 * All processes use a single Wave community image that bundles:
 *   bowtie2, EsViritu, fastp, samtools, seqkit, r-tidyverse
 * ESVIRITU uses a custom image that extends the base with the dataui R package
 *   (required for sparkline coverage plots in the reactable HTML report).
 */

process {
    container = 'community.wave.seqera.io/library/bowtie2_esviritu_samtools_seqkit_r-tidyverse:3ee4a52f7d6ae7d9'

    withName: 'ESVIRITU' {
        container = 'esviritu_pipeline:latest'
    }

    // Validation sub-workflow:
    //   SPLIT_VIRAL_READS, SPADES_ASSEMBLY, MAKE_HOST_BLASTDB, FILTER_HOST_CONTIGS and BLASTN_VALIDATE share an image
    //   that bundles blast+, samtools, seqkit, and SPAdes.
    withName: 'SPLIT_VIRAL_READS|SPADES_ASSEMBLY|MAKE_HOST_BLASTDB|FILTER_HOST_CONTIGS|BLASTN_VALIDATE' {
        container = 'community.wave.seqera.io/library/blast_samtools_seqkit_spades:fc92dccb1ec56163'
    }

    // Contig scaffolding: SCAFFOLD_GROUPS, SCAFFOLD_MINIMAP2 and POLISH_SCAFFOLD use
    // the default image (R, minimap2, samtools >= 1.16 consensus, bowtie2, seqkit).

    withName: 'SUMMARIZE_READ_STATS|MAKE_OVERVIEW_TABLE|VISUALIZE_VALIDATION' {
        container = 'community.wave.seqera.io/library/r-pdftools_r-tidyverse:eb8d2ad34f3396f1'
    }
}
