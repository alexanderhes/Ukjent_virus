/*
 * Default pipeline parameters
 * Override on the command line:  --param value
 * or in a custom params file:    -params-file my_params.yaml
 */

params {
    // ── Required ───────────────────────────────────────────────────────────────
    samplesheet     = null          // Path to samplesheet CSV/TSV (sample;fastq_dir)
    host_index      = null          // Path to bowtie2 index prefix (without .bt2 extension)
    host_blastdb    = null          // Host BLAST database prefix for FILTER_HOST_CONTIGS; built from host_index if missing
    esviritu_db     = null          // Path to EsViritu virus database directory

    // ── Output ─────────────────────────────────────────────────────────────────
    outdir          = './results'

    // ── Samplesheet ────────────────────────────────────────────────────────────
    samplesheet_sep = ';'           // Column delimiter (';' | ',' | '\t')

    // ── Host filter ────────────────────────────────────────────────────────────
    // false (default): single paired-end bowtie2 run with --sensitive-local.
    // true: original high-sensitivity mode — unpaired --very-sensitive-local on
    //       R1 and R2 separately, then seqkit pair re-synchronisation.
    sensitive_host_filter   = false

    // ── fastp ──────────────────────────────────────────────────────────────────
    min_length              = 50
    quality_cutoff          = 20
    complexity_threshold    = 30    // Low-complexity filter threshold (0-100)

    // ── EsViritu ───────────────────────────────────────────────────────────────
    esviritu_keep   = true          // Keep temp files (needed for future downstream modules)

    // ── Validation sub-workflow ───────────────────────────────────
    validate                = false   // Enable per-species assembly + BLAST validation
    validate_min_reads      = 50      // Min reads per species to attempt SPAdes assembly
    validate_min_contig_len = 800     // Filter SPAdes contigs shorter than this (nt)
    validate_spades_max_pairs = 500000 // If >0, subsample sample-level read pairs above this cap before SPAdes
    validate_spades_sample_seed = 11   // Random seed for deterministic SPAdes input subsampling
    // Remove host contigs before BLAST, mainly human rRNA that assembles into contigs
    // (multi-copy rRNA reads can pass HOST_FILTER as non-concordant pairs).
    host_contig_filter      = true
    host_contig_max_pct     = 50      // Remove a contig when >= this % of its length is covered by host BLAST hits
    host_contig_min_identity = 90     // Minimum identity (%) of host BLAST hits counted towards that coverage
    // Protein-level rescue in BLASTN_VALIDATE: tblastx of contigs with no or too little
    // blastn support (below the verdict_artefact_* thresholds). Passing hits are added
    // to the overview as verdict protein_hit_only (or tblastx_* columns). Experimental.
    tblastx_rescue          = true
    // Combine the contigs of each taxon (or segment) into one genome per sample,
    // ordered against the best BLAST reference and polished with the sample's reads.
    scaffold                = true        // Only runs with --validate (minimap2 + samtools consensus)
    // Coverage grades for genome_assessment (polished genome, % of the reference
    // called) and blast_assessment (% of the reference covered by contigs):
    // complete >= genome_complete_pct, high >= genome_high_pct, partial >=
    // genome_partial_pct, low >= genome_low_pct, below = fragmented.
    // A polished genome >= genome_partial_pct also makes blast_verdict confirmed.
    genome_complete_pct     = 90
    genome_high_pct         = 70
    genome_partial_pct      = 50
    genome_low_pct          = 30
    scaffold_max_overhang   = 300         // Max contig bases added beyond a reference end (0 = no overhangs)
    polish_rounds           = 1           // Read-mapping polish iterations (0 = contigs only, fill becomes N)
    polish_contig_bases     = 'fallback'  // Contig positions: fallback = reads decide where depth >= polish_min_depth, contig base kept below;
                                          //   keep = contig base always kept; reads = reads decide everywhere (N below min depth)
    polish_min_depth        = 5           // Reads decide a base (majority) at >= this depth; below: contig base kept, else N

    // ── Overview verdict thresholds ─────────────────────────────────────
    // WORK IN PROGRESS: the verdict_* values below are provisional. They were
    // set from one 3-sample test run (20260930_hanta_test), are not validated,
    // and are expected to change. While verdict_thresholds_provisional = true,
    // every run prints a warning at start and end; set it to false once the
    // thresholds have been validated.
    verdict_thresholds_provisional = true
    // verdict = confirmed when esv_verdict = supported OR blast_verdict = confirmed;
    // probable when blast_verdict = inconclusive or EsViritu passes the probable
    // rule below; artefact_suspected (BLAST-only artefacts); weak otherwise.
    // Mapping evidence (EsViritu): esv_verdict = supported when all three pass.
    // Failing one raises esv_flags low_reads / low_rpm / low_breadth.
    verdict_esv_min_reads        = 10    // Min EsViritu read count
    verdict_esv_min_rpm          = 10    // Min reads per million raw reads (RPM)
    verdict_esv_min_breadth_pct  = 30    // Min EsViritu breadth (%); segmented viruses: best segment
    verdict_esv_probable_min_breadth_pct = 5  // verdict probable: >= min reads and breadth >= this
    // De novo evidence (SPAdes + BLAST). blast_verdict = artefact_suspected when the
    // best contig's BLAST hits cover < artefact_max_aln_bp or < artefact_max_aln_pct
    // of it (these contigs are also left out of scaffolding, SCAFFOLD_GROUPS);
    // otherwise confirmed when the contigs together cover >= blast_min_ref_bp or
    // >= blast_min_ref_pct of the reference (all segments together), or the
    // polished genome covers >= genome_partial_pct; otherwise inconclusive.
    verdict_blast_min_ref_bp     = 1000  // Reference bases covered by the taxon's contigs
    verdict_blast_min_ref_pct    = 30    // ... or % of the reference covered
    verdict_artefact_max_aln_bp  = 200   // blast_verdict = artefact_suspected: aligned bp < this ...
    verdict_artefact_max_aln_pct = 20    // ... or % of contig aligned < this
    // Flags only (do not change verdicts).
    verdict_esv_divergent_identity_pct   = 90  // esv_flags divergent: EsViritu read identity (%) < this
    verdict_blast_divergent_identity_pct = 90  // blast_flags divergent: BLAST identity (%) < this
    verdict_recurrent_min_samples        = 2   // flags in_<k>/<N>_samples: taxon in >= this many samples
    // SPAdes assembly mode used during validation.
    // null = auto-detect from esviritu_db name (HEV → rnaviral, otherwise meta).
    // Override explicitly: rnaviral | meta | isolate
    spades_mode             = null
    // Taxonomic level used for grouping reads before assembly.
    // 'subspecies' (default): uses subspecies where available, falling back to species.
    //   Recommended for virus groups where one Species contains many distinct viruses
    //   (e.g. Enteroviruses, Rotaviruses).
    // 'species': always group at species level.
    assembly_taxon_level    = 'subspecies'

    // ── Misc ───────────────────────────────────────────────────────────────────
    max_cpus        = 8
    max_memory      = '128.GB'
    max_time        = '72.h'
}
